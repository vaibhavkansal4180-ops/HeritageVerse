# ==============================================================================
# HeritageVerse – Environment Variables Configuration Template
# ==============================================================================

# Database Connection URI (PostgreSQL for Production, SQLite for Local Testing)
# Examples:
#   PostgreSQL: postgresql://user:password@host:5432/heritageverse?sslmode=require
#   Local SQLite (Leave empty to use default local file): sqlite:///backend/heritageverse.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/heritageverse

# Secret Key for JWT Token Generation and Cryptographic Signing (Use a strong random string in production)
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-production

# Environment Mode: 'production' or 'development'
FLASK_ENV=production

# Debug Mode: 'false' for production, 'true' for local development
DEBUG=false

# CORS Allowed Origins (Comma-separated or '*' for public access)
# Example: https://heritageverse.vercel.app,http://localhost:5000
CORS_ORIGINS=*

# Server Port (Default: 5000)
PORT=5000
