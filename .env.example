# HeritageVerse Environment Configuration Example

# Flask Secret Key
SECRET_KEY=heritageverse-super-secret-key-2026-royal-india

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=heritageverse

# Optional explicit DATABASE_URL (overrides individual MySQL variables)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/heritageverse?charset=utf8mb4

# Server Port
PORT=5000

# File Upload Settings
MAX_CONTENT_LENGTH=5242880
FLASK_ENV=development
